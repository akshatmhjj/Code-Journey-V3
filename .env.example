# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.
# Every variable is explained in docs/developer-setup.md (section 4).

# --- Required ---------------------------------------------------------------
# Supabase: project settings, API. Safe in the browser (row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SERVER ONLY. It bypasses all security rules, so never use a NEXT_PUBLIC_ name for it.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard at /admin. Choose any password.
ADMIN_PASSWORD=

# Google AI Studio key for CJ AI (chat and indexing).
GEMINI_API_KEY=

# Weekly progress email (optional locally, required in production).
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=

# --- Optional tuning (defaults shown) ---------------------------------------
# CJ_DAILY_LIMIT=40
# CJ_MIN_SIMILARITY=0.55
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# GEMINI_EMBED_MODEL=gemini-embedding-2
# WEEKLY_EMAIL_DAILY_CAP=100

# Optional: a Slack or Discord webhook. When set, outages in CJ AI and the weekly email are posted there.
# ALERT_WEBHOOK_URL=
